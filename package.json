{
  "name": "memecoin-intelligence-terminal",
  "private": true,
  "version": "0.1.0",
  "description": "Solana Memecoin Intelligence Scanner and Trading Terminal",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @memecoin/database generate",
    "db:migrate": "pnpm --filter @memecoin/database migrate",
    "db:seed": "pnpm --filter @memecoin/database seed",
    "db:studio": "pnpm --filter @memecoin/database studio",
    "dev:ingest-sample": "pnpm --filter @memecoin/indexer ingest-sample",
    "dev:discover-tokens": "pnpm --filter @memecoin/indexer discover-tokens",
    "dev:discover-wallets": "pnpm --filter @memecoin/indexer discover-wallets",
    "dev:backfill-signal-scores": "pnpm --filter @memecoin/indexer backfill-signal-scores",
    "dev:backfill-alert-outcomes": "pnpm --filter @memecoin/indexer backfill-alert-outcomes",
    "dev:ingest-wallet": "pnpm --filter @memecoin/indexer ingest-wallet --",
    "dev:classify-wallet": "pnpm --filter @memecoin/indexer classify-wallet --",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
