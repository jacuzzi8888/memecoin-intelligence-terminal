{
  "name": "@memecoin/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "ingest-sample": "tsx src/commands/ingest-sample.ts",
    "discover-tokens": "tsx src/commands/discover-tokens.ts",
    "ingest-wallet": "tsx src/commands/ingest-wallet.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@memecoin/config": "workspace:*",
    "@memecoin/database": "workspace:*",
    "@memecoin/logger": "workspace:*",
    "@memecoin/queue": "workspace:*",
    "@memecoin/schemas": "workspace:*",
    "@memecoin/solana": "workspace:*",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
