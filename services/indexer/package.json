{
  "name": "@memecoin/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "ingest-sample": "tsx src/commands/ingest-sample.ts",
    "discover-tokens": "tsx src/commands/discover-tokens.ts",
    "discover-wallets": "tsx src/commands/discover-wallets.ts",
    "backfill-signal-scores": "tsx src/commands/backfill-signal-scores.ts",
    "backfill-alert-outcomes": "tsx src/commands/backfill-alert-outcomes.ts",
    "stream-transactions": "tsx src/commands/stream-transactions.ts",
    "ingest-wallet": "tsx src/commands/ingest-wallet.ts",
    "classify-wallet": "tsx src/commands/classify-wallet.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@memecoin/alerts": "workspace:*",
    "@memecoin/config": "workspace:*",
    "@memecoin/database": "workspace:*",
    "@memecoin/intelligence": "workspace:*",
    "@memecoin/logger": "workspace:*",
    "@memecoin/notifications": "workspace:*",
    "@memecoin/processor": "workspace:*",
    "@memecoin/queue": "workspace:*",
    "@memecoin/schemas": "workspace:*",
    "@memecoin/solana": "workspace:*",
    "@solana/web3.js": "^1.98.0",
    "drizzle-orm": "^0.38.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
