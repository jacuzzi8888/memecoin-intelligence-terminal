{
  "name": "@memecoin/alerts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@memecoin/config": "workspace:*",
    "@memecoin/logger": "workspace:*",
    "@memecoin/database": "workspace:*",
    "@memecoin/schemas": "workspace:*",
    "@memecoin/notifications": "workspace:*",
    "@memecoin/queue": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
