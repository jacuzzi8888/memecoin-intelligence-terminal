# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://memecoin:memecoin_dev@localhost:5433/memecoin_intelligence
DATABASE_URL_UNPOOLED=postgresql://memecoin:memecoin_dev@localhost:5433/memecoin_intelligence

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development-secret-change-in-production-minimum-32-chars

# API
API_URL=http://localhost:4000
API_PORT=4000
API_HOST=0.0.0.0

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Data Providers (optional - system runs without these in dev mode)
HELIUS_API_KEY=
BIRDEYE_API_KEY=
DEXSCREENER_API_KEY=

# Telegram Bot (optional - alerts log to structured output when not configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Notification Channels (optional)
DISCORD_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Trading (Jupiter)
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# Feature Flags
ENABLE_DEV_AUTH=true
ENABLE_DEV_INGESTION=true
ENABLE_LIVE_TRADING=false
ENABLE_PAID_PROVIDERS=false
PERSONAL_APP_MODE=false
API_WRITE_TOKEN=replace-with-a-random-personal-write-key-at-least-32-characters
INDEXER_ENABLE_STREAM=true
INDEXER_ENABLE_DISCOVERY=true
INDEXER_EMBED_PROCESSOR=false
INDEXER_EMBED_ALERTS=true
ALERTS_RUN_RECOVERY_PASS=true
SIGNAL_SCORE_BACKFILL_ON_START=true
SIGNAL_SCORE_BACKFILL_LIMIT=2000
SIGNAL_SCORE_BACKFILL_SINCE_DAYS=7
DISCOVERY_SCHEDULE_MS=15000
DISCOVERY_MAX_EVENTS=150
DISCOVERY_SIGNAL_REFRESH_MINUTES=45
WALLET_SYNC_AUTOMATION_ENABLED=true
WALLET_DISCOVERY_AUTOMATION_ENABLED=true
WALLET_DISCOVERY_SCHEDULE_MS=900000
DISCOVER_WALLET_SINCE_HOURS=24
DISCOVER_WALLET_TOKEN_LIMIT=12
DISCOVER_WALLET_TX_LIMIT=25
DISCOVER_WALLET_LIMIT=8
DISCOVER_WALLET_MIN_SCORE=8
ALERT_OUTCOME_AUTOMATION_ENABLED=true
ALERT_OUTCOME_SCHEDULE_MS=900000
ALERT_OUTCOME_LIMIT=500
ALERT_OUTCOME_SINCE_DAYS=7

NEXT_PUBLIC_API_URL=http://localhost:4000
