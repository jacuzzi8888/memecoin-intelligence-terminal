# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://memecoin:memecoin_dev@localhost:5433/memecoin_intelligence
DATABASE_URL_UNPOOLED=postgresql://memecoin:memecoin_dev@localhost:5433/memecoin_intelligence

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development-secret-change-in-production-minimum-32-chars

# API
API_URL=http://localhost:4000
API_PORT=4000
API_HOST=0.0.0.0

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Data Providers (optional - system runs without these in dev mode)
HELIUS_API_KEY=
BIRDEYE_API_KEY=
DEXSCREENER_API_KEY=

# Telegram Bot (optional - alerts log to structured output when not configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Notification Channels (optional)
DISCORD_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Trading (Jupiter)
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# Feature Flags
ENABLE_DEV_AUTH=true
ENABLE_DEV_INGESTION=true
ENABLE_LIVE_TRADING=false
ENABLE_PAID_PROVIDERS=false

NEXT_PUBLIC_API_URL=http://localhost:4000